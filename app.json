{
  "expo": {
    "name": "XRecord",
    "slug": "xrecord",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.xrecord.app",
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "SYSTEM_ALERT_WINDOW",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": ["expo-dev-client"]
  }
}